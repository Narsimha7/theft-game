# Server Port
PORT=3000

# MongoDB Connection String (Replace with your MongoDB Atlas or Local MongoDB URI)
# Example Local: mongodb://127.0.0.1:27017/covert_game
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/covert_game?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/covert_game

# Database Name
DB_NAME=covert_game
